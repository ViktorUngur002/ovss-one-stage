# Copy to exp/env.sh (untracked) and adjust. Sourced by scripts/exp_*.sh.

# --- weights & biases -------------------------------------------------------
export WANDB_PROJECT="ovss-catseg"
export WANDB_ENTITY="viktor-ungur-university-politehnica-timisoara"
# Keep wandb's local run files off the small root partition.
export WANDB_DIR="/mnt/win-data/MasterDisertatie/cache/wandb"
# export WANDB_MODE=offline        # uncomment to train without a network

# --- where runs are stored (one folder per commit = detectron2 OUTPUT_DIR) ---
export EXP_MYRUNS_ROOT="/mnt/win-data/MasterDisertatie/MyRuns-OVSS"

# --- datasets (CAT-Seg layout: coco-stuff, ADEChallengeData2016, ADE20K_2021_17_01, VOCdevkit) ---
export DETECTRON2_DATASETS="/home/viktor/MasterDisertatie/datasets"

# --- torch hub cache off the root partition ---------------------------------
export TORCH_HOME="/mnt/win-data/MasterDisertatie/cache/torch"

# --- what counts as "best" (flattened in-training eval results) -------------
export EXP_BEST_METRIC_KEYS="sem_seg/mIoU"
export EXP_BEST_METRIC_NAME="intrain_mIoU"

# --- cloud copy (weights only, never the resumable checkpoints) -------------
export EXP_RCLONE_ENABLED=1
export EXP_RCLONE_REMOTE="gdrive:MyRuns-OVSS"
export EXP_CLOUD_WEIGHTS_ENABLED=1
export EXP_CLOUD_WEIGHTS_DTYPE="fp16"

# --- checkpoints on disk: newest N periodic model_XXXXXXX.pth (+ model_best, model_final) ---
export EXP_KEEP_PERIODIC_CHECKPOINTS=1

# --- wandb training-scalar period in iterations (multiple of 20) ------------
export EXP_LOG_EVERY_N_ITERS=20
